# Copy this to .env and fill in your values.

# ── Local dev (Docker PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://saheli:saheli_dev@localhost:5432/digital_saheli"
DIRECT_URL="postgresql://saheli:saheli_dev@localhost:5432/digital_saheli"

# ── Production (Neon) ──────────────────────────────────────────────────────
# DATABASE_URL="postgresql://<user>:<pass>@<pooler-host>/<db>?sslmode=require"
# DIRECT_URL="postgresql://<user>:<pass>@<direct-host>/<db>?sslmode=require"

# ── Auth (required in production) ─────────────────────────────────────────
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Demo accounts (reference only, not rendered on UI) ────────────────────
DEMO_LEARNER_EMAIL="demo@saheli.demo"
DEMO_ADMIN_EMAIL="admin@saheli.demo"
DEMO_PASSWORD="Demo@123"
